        ├── CheckListScreen.js        → Formulaire check list + export PDF
        ├── CollaborateursScreen.js   → Toggle collaborateur sur agents existants
        ├── CompteRenduScreen.js      → Compte Rendu KN1 depuis checklist
        └── RapportPeriodiqueScreen.js → Rapport mensuel depuis planning
```

### authService.js — URL importante
```javascript
import { Platform } from 'react-native';
export const API_URL = Platform.OS === 'web'
  ? 'http://localhost:8080/api/auth'
  : 'http://VOTRE_IP_WIFI:8080/api/auth';
// Remplacer VOTRE_IP_WIFI par l'IP trouvée via ipconfig (Adresse IPv4 Wi-Fi)
```

